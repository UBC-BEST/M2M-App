{
  "extends": "@tsconfig/recommended/tsconfig.json",

  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ESNext",
    "sourceMap": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noUncheckedSideEffectImports": false,
    "types": ["node", "jest"]
  },
  "include": ["src", "tests"]
}
