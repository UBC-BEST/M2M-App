{
  "name": "m2m-server",
  "version": "1.0.0",
  "description": "Express server for the M2M project",
  "main": "dist/bundle.mjs",
  "packageManager": "yarn@4.18.1",
  "private": true,
  "scripts": {
    "start": "node scripts/build.mjs && node dist/bundle.mjs",
    "dev": "nodemon -x yarn start",
    "test": "jest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "jsonwebtoken": "9.0.3",
    "luxon": "^3.7.2",
    "mailgun.js": "^14.0.1",
    "mongodb": "^7.6.0",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "~2.8.19",
    "@types/eslint-config-prettier": "~6.11.3",
    "@types/express": "~5.0.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "~7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "nodemonConfig": {
    "ignore": [
      ".yarn/",
      "tests/",
      "dist/",
      "node_modules/"
